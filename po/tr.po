msgid "No Symbols"
msgstr "Simge Yok"

#: ../lib/window.rb:301 ../lib/window.rb:375
msgid "Start by drawing a symbol"
msgstr "Simge çizerek başla"

#: ../lib/window.rb:325
msgid "All Symbols"
msgstr "Tüm Simgeler"

#: ../lib/window.rb:352
msgid "_Clear"
msgstr "_Temizle"

#: ../lib/window.rb:417
msgid "Main Menu"
msgstr "Ana Menü"

