msgid "Copy"
msgstr "Kopírovat"

#: ../lib/window.rb:134
msgid "Copied “%{command}”"
msgstr "Zkopírováno „%{command}“"

#: ../lib/window.rb:295 ../lib/window.rb:374
msgid "No Symbols"
msgstr "Žádné symboly"

#: ../lib/window.rb:301 ../lib/window.rb:375
msgid "Start by drawing a symbol"
msgstr "Začněte načrtnutím symbolu"

#: ../lib/window.rb:325
msgid "All Symbols"
msgstr "Všechny symboly"

#: ../lib/window.rb:352
msgid "_Clear"
msgstr "Vy_mazat"

