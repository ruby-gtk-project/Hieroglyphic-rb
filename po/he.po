#: ../data/org.rubygtkproject.Hieroglyphic.desktop.in:2
#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:8 ../lib/about.rb:47
#: ../lib/window.rb:177 ../lib/window.rb:405
msgid "Hieroglyphic"
msgstr "הירוגליפי"

#: ../data/org.rubygtkproject.Hieroglyphic.desktop.in:3
msgid "Search through over 1000 different LaTeX symbols by sketching"
msgstr "חיפוש מתוך למעלה מ־1000 סמלי LaTeX שונים באמצעות רישום בכתב יד"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: ../data/org.rubygtkproject.Hieroglyphic.desktop.in:9
msgid "GTK;Tools;LaTeX;TeX;Symbols;Typst;Math;"
msgstr "GTK;כלים;לאטך;לטקס;לטך;LaTeX;TeX;סמלים;מתמטיקה;Typst;"

#. Translators: nudge means here a gentle prompt, i.e. the colored dot on the button
#: ../data/schemas/org.rubygtkproject.Hieroglyphic.gschema.xml:7
msgid "Whether to show a small nudge towards the contribution dialog"
msgstr "האם להציג סימון מפנה קטן לעבר חלונית התרומה"

#: ../data/schemas/org.rubygtkproject.Hieroglyphic.gschema.xml:11
msgid "Whether to contribute recognized strokes"
msgstr "האם לתרום את הצורות שזוהו"

#. Translators: the name of the markup language (latex, typst) for which symbols are suggested
#: ../data/schemas/org.rubygtkproject.Hieroglyphic.gschema.xml:21
msgid "Markup language to suggest symbols for"
msgstr "שפת סימון עבורה להציע סמלים"

#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:9
msgid "Find LaTeX and Typst symbols"
msgstr "חיפוש סמלי LaTeX ו־Typst"

#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:18
msgid ""
"If you work with LaTeX or Typst, you know it's difficult to memorize the "
"names of all the symbols. Hieroglyphic allows you to search through over "
"1000 different symbols by sketching."
msgstr ""
"אם עבדת עם LaTeX או עם Typst, בוודאי מוכר לך הקושי לזכור את השמות של הסמלים "
"השונים. היישום הירוגליפי מאפשר לך לחפש מתוך למעלה מ־1000 סמלים באמצעות רישום "
"בכתב יד."

#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:30
msgid "Symbol selection for LaTeX symbols"
msgstr "בחירת סמלים לסמלי LaTeX"

#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:34
msgid "Symbol selection for Typst symbols"
msgstr "בחירת סמל לסמלי Typst"

#: ../data/org.rubygtkproject.Hieroglyphic.metainfo.xml.in:38
msgid "Placeholder"
msgstr "ממלא מקום"

#: ../lib/about.rb:55
msgid "translator-credits"
msgstr "יוסף אור בוצ׳קו <yoseforb@gmail.com>"

#: ../lib/contribution_dialog.rb:57 ../lib/contribution_dialog.rb:102
#: ../lib/window.rb:411
msgid "Improve Hieroglyphic"
msgstr "שיפור הירוגליפי"

#: ../lib/contribution_dialog.rb:112
msgid "Help make Hieroglyphic better at identifying symbols for everyone"
msgstr "אפשר לסייע בשיפור הירוגליפי בזיהוי סמלים לכולם"

#: ../lib/contribution_dialog.rb:127
msgid "Contribute Symbols"
msgstr "תרומת סמלים"

#: ../lib/contribution_dialog.rb:128
msgid "Submit recognized drawings to Hieroglyphic’s dataset"
msgstr "הגשת הציורים המזוהים לערכת הנתונים של הירוגליפי"

#: ../lib/primary_menu.rb:15
msgid "LaTeX"
msgstr "LaTeX"

#: ../lib/primary_menu.rb:16
msgid "Typst"
msgstr "Typst"

#: ../lib/primary_menu.rb:21
msgid "Markup language"
msgstr "שפת סימון"

#: ../lib/primary_menu.rb:31
msgid "About Hieroglyphic"
msgstr "על הירוגליפי"

#: ../lib/symbol_item.rb:98
msgid "Copy"
msgstr "העתקה"

#: ../lib/window.rb:134
msgid "Copied “%{command}”"
msgstr "‏‎„%{command}” הועתק"

#: ../lib/window.rb:295 ../lib/window.rb:374
msgid "No Symbols"
msgstr "אין סמלים"

#: ../lib/window.rb:301 ../lib/window.rb:375
msgid "Start by drawing a symbol"
msgstr "התחלה על ידי ציור סמל"

#: ../lib/window.rb:325
msgid "All Symbols"
msgstr "כל הסמלים"

#: ../lib/window.rb:352
msgid "_Clear"
msgstr "_ניקוי"

#: ../lib/window.rb:417
msgid "Main Menu"
msgstr "תפריט ראשי"

